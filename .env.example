# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local Docker example: postgresql://postgres:password@localhost:5432/competition
# Neon / Vercel Postgres: copy from the dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Your app's base URL — no trailing slash.
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (for admin login + Calendar API) ────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a project, enable "Google Calendar API" and "Google+ API"
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorised redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# ─── Admin Access ─────────────────────────────────────────────────────────────
# Only this Gmail address will be allowed to sign in as admin.
ADMIN_EMAIL="you@gmail.com"

# ─── Public App Config ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Competition 2025"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
